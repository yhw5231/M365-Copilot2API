# HTTP bind address (default: 127.0.0.1:9090)
M365_LISTEN=127.0.0.1:9090

# OAuth/account cache. Keep this file private and mode 0600.
M365_CONFIG=$HOME/.config/m365-copilot2api/accounts.json

# Required administrator password for the web console and management APIs.
# Never commit a real value.
# - Standalone / manage.py: consumed directly by the app.
# - Docker: docker-compose.yml reads it from the .env file and passes it to the
#   container as M365_ADMIN_PASSWORD (preferred over the otherwise-empty
#   /data/admin-password file bootstrap). Leave empty to fall back to admin123.
M365_ADMIN_PASSWORD=admin123

# Optional: place all runtime state under one writable directory. Explicit
# per-file paths such as M365_CONFIG still take precedence when provided.
# M365_DATA_DIR=~/.config/m365-copilot2api

# Proxy mode (default: strict):
#   direct -> never use the proxy pool, all requests connect directly
#   loose  -> prefer the pool, fall back to direct when no healthy node is left
#   strict -> once a pool is configured, requests must use a healthy proxy node
#             or fail with "no healthy proxy node available"
# The value can also be changed from the web console (Settings -> Proxy pool).
# Legacy M365_ENFORCE_PROXY=1/0 is still honored (maps to strict / loose).
# M365_PROXY_MODE=strict
